# ==============================================================================
# WASHROOM - Hostel Laundry Management Environment Variables
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Free hosted Postgres providers: Supabase (https://supabase.com), Neon (https://neon.tech), or Render
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/hostel_laundry

# Optional database pool tuning for 100+ concurrent users
DB_POOL_MAX=20
DB_SSL=true

# ------------------------------------------------------------------------------
# 2. Authentication (Clerk - https://clerk.com)
# ------------------------------------------------------------------------------
# Create a free project at Clerk.com, go to API Keys, and copy these values:
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Frontend Publishable Key (Vite will embed this into the client bundle)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Optional: If frontend is deployed separately from the API server
# VITE_API_URL=https://your-api-domain.com
